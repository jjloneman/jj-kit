{
  "author": {
    "name": "JJ Loneman",
    "url": "https://github.com/jjloneman"
  },
  "bugs": {
    "url": "https://github.com/jjloneman/jj-kit/issues"
  },
  "description": "🧹 The kit's own ESLint rules, such as no-dotted-jsdoc-param, under the jj-kit namespace.",
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@jjloneman/kit-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "homepage": "https://github.com/jjloneman/jj-kit/tree/main/packages/eslint-plugin#readme",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "jsdoc",
    "tsdoc"
  ],
  "license": "MIT",
  "name": "@jjloneman/kit-eslint-plugin",
  "peerDependencies": {
    "eslint": "^10.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "directory": "packages/eslint-plugin",
    "type": "git",
    "url": "git+https://github.com/jjloneman/jj-kit.git"
  },
  "scripts": {
    "build": "tsdown",
    "lint:package": "pnpm build && publint && attw --pack --profile esm-only",
    "typecheck": "tsc"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.0.0"
}
