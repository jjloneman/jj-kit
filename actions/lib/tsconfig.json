/*
 * Typechecks this action's scripts, which Node runs unbuilt under type
 * stripping.
 *
 * - `lib.json` adds `isolatedDeclarations`, so every export declares its
 *   types, and `node.json` the settings for running under Node.
 */
{
  "extends": [
    "@jjloneman/kit-tsconfig/lib.json",
    "@jjloneman/kit-tsconfig/node.json"
  ],
  "include": ["src"]
}
